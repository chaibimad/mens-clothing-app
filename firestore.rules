rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────
    
    // Checks if the request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the user is the owner of the document based on UID
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Checks if the logged-in user profile has role === 'admin'
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─────────────────────────────────────────────
    // 1. Users Collection
    // Path: /users/{uid}
    // ─────────────────────────────────────────────
    match /users/{uid} {
      // Authenticated users can read other profiles (for displaying names on reviews/orders)
      allow read: if isAuthenticated();
      // Allow profile creation during signup, self-updates, or full controls by admin
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();

      // Users Saved Addresses subcollection
      // Path: /users/{uid}/addresses/{addressId}
      match /addresses/{addressId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // ─────────────────────────────────────────────
    // 2. Categories Collection
    // Path: /categories/{categoryId}
    // ─────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin(); // Only admins can create/edit/delete
    }

    // ─────────────────────────────────────────────
    // 3. Products Collection
    // Path: /products/{productId}
    // ─────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin(); // Only admins can manage products

      // Product Variants subcollection
      // Path: /products/{productId}/variants/{variantId}
      match /variants/{variantId} {
        allow read: if true; // Publicly readable
        // Admins can manage variants, standard checkouts can atomically update stock
        allow write: if isAdmin() || (isAuthenticated() && request.resource.data.stock_quantity is int);
      }

      // Product Reviews subcollection
      // Path: /products/{productId}/reviews/{reviewId}
      match /reviews/{reviewId} {
        allow read: if true; // Publicly readable
        // Authenticated users can create their own reviews
        allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
        // Owners or Admins can edit/delete reviews
        allow update, delete: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
      }
    }

    // ─────────────────────────────────────────────
    // 4. Carts Collection
    // Path: /carts/{uid}
    // ─────────────────────────────────────────────
    match /carts/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();

      // Cart Items subcollection
      match /items/{itemId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // ─────────────────────────────────────────────
    // 5. Orders Collection
    // Path: /orders/{orderId}
    // ─────────────────────────────────────────────
    match /orders/{orderId} {
      // Standard users can read their own orders; admins can manage all orders
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
      // Users can place orders under their own UID
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();

      // Order Items subcollection
      match /items/{itemId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }

      // Order Payment subcollection (single doc per order)
      match /payment/{paymentId} {
        allow read: if isAuthenticated() && (get(/databases/$(database)/documents/orders/$(orderId)).data.user_id == request.auth.uid || isAdmin());
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }
  }
}
